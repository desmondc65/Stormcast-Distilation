graph TD
    subgraph Input
        COND["Condition Tensor<br>(background, state,<br>regression, invariants)"]
        NOISE["Gaussian Noise<br>z ~ N(0, sigma_max^2 I)"]
        REAL["Real Residual<br>(ground truth target)"]
    end

    subgraph Student["ADD-Student (1-4 Step Denoising)"]
        DENOISE["Student Denoiser<br>(EDMPrecond, trainable)<br>Initialized from teacher"]
    end

    NOISE --> DENOISE
    COND --> DENOISE
    DENOISE --> FAKE["Student-Generated<br>Residual"]

    subgraph DiscriminatorPath["Discriminator Update"]
        DISC["Multi-Scale<br>Discriminator<br>(trainable)"]
        HINGE["Hinge Loss<br>D(real) towards +1<br>D(fake) towards -1"]
        R1["R1 Gradient Penalty<br>on real samples"]
        DLOSS["Discriminator Loss<br>L_D = L_hinge + gamma * R1"]
    end

    REAL --> DISC
    FAKE -- "detached" --> DISC
    DISC --> HINGE
    DISC --> R1
    HINGE --> DLOSS
    R1 --> DLOSS
    DLOSS -- "update discriminator" --> DISC

    subgraph GeneratorPath["Student (Generator) Update"]
        ADV["Adversarial Loss<br>Fool discriminator<br>into classifying<br>fake as real"]
        DISTILL["Score Distillation Loss"]
        GLOSS["Generator Loss<br>L_G = L_adv + lambda * L_distill"]
    end

    FAKE --> ADV
    ADV --> GLOSS
    FAKE --> DISTILL
    DISTILL --> GLOSS
    GLOSS -- "update student" --> DENOISE

    subgraph ScoreDistillation["Score Distillation Detail"]
        NOISESTEP["Add noise to<br>student output<br>x_noised = x + sigma * eps"]
        TEACHER["Frozen DM-Teacher<br>(pretrained EDM, fixed)"]
        L2["Weighted L2 Loss<br>w(sigma) * ||x_student - x_teacher||^2"]
    end

    FAKE --> NOISESTEP
    NOISESTEP --> TEACHER
    COND --> TEACHER
    TEACHER --> L2
    L2 --> DISTILL

    subgraph EMA["Exponential Moving Average"]
        EMANET["EMA Student<br>(used for validation<br>and inference)"]
    end

    DENOISE -- "EMA update<br>after each step" --> EMANET

    style Input fill:#e8f4fd,stroke:#2196F3
    style Student fill:#fff3e0,stroke:#FF9800
    style DiscriminatorPath fill:#fce4ec,stroke:#E91E63
    style GeneratorPath fill:#e8f5e9,stroke:#4CAF50
    style ScoreDistillation fill:#f3e5f5,stroke:#9C27B0
    style EMA fill:#fff9c4,stroke:#FFC107
